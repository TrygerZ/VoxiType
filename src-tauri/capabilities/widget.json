{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "widget",
  "description": "Minimal capability for the floating widget overlay window",
  "windows": ["floating-widget"],
  "permissions": [
    "core:default",
    "core:window:default",
    "core:window:allow-start-dragging",
    "core:event:default",
    "core:event:allow-listen"
  ]
}
